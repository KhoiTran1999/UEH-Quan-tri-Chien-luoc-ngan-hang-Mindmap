<mxfile host="Electron">
  <diagram name="Quản trị và Chiến lược Ngân hàng - Chương 4" id="Chapter4-BankStrategyPlanning-Mindmap">
    <mxGraphModel dx="1891" dy="-1481" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TITLE_BANNER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;shadow=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="95" width="2350" x="1620" y="3162" as="geometry" />
        </mxCell>
        <mxCell id="TITLE_TEXT" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#ffffff;fontSize=24;fontStyle=1;" value="CHƯƠNG 4: HOẠCH ĐỊNH CHIẾN LƯỢC KINH DOANH NGÂN HÀNG&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.85; color: #94a3b8;&quot;&gt;Entity-based Hierarchical Mindmap | Đào sâu Chiến lược [E3] NHTM | Quy trình 11 Bước | Ma trận 3x3 Danh mục Thị trường &amp;amp; Kiểm tra Chiến lược&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="2310" x="1640" y="3172" as="geometry" />
        </mxCell>
        <mxCell id="E3_ROOT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0D47A1;strokeColor=#1565C0;fontColor=#ffffff;fontStyle=1;fontSize=14;shadow=1;fontFamily=Helvetica;" value="🏛️ [E3] TRỤC CỐT LÕI: HOẠCH ĐỊNH CHIẾN LƯỢC KINH DOANH NGÂN HÀNG THƯƠNG MẠI&lt;br/&gt;&lt;span style=&quot;opacity: 0.9; font-size: 11px; font-weight: normal;&quot;&gt;Định vị Tương lai | Quy trình Hoạch định 11 Bước | Ma trận Danh mục Thị trường (GE/McKinsey) &amp;amp; Kiểm soát Chiến lược&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="620" x="2485" y="3295" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E1_NHNN" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#263238;strokeColor=#37474F;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏛️ [E1] NGÂN HÀNG TRUNG ƯƠNG (NHNN)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Định hướng CSTT vĩ mô, khống chế trần Room tín dụng,&lt;br/&gt;ban hành chuẩn an toàn vốn &amp;amp; định hướng ngành ưu tiên; NHTM phải tuân thủ&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="960" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E8_FINTECH" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#880E4F;strokeColor=#AD1457;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="📱 [E8] CÔNG NGHỆ TÀI CHÍNH &amp;amp; NỀN TẢNG SỐ (FINTECH &amp;amp; AI)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Yếu tố công nghệ vĩ mô, Big Data, Open Banking, AI phân tích hành vi;&lt;br/&gt;vừa là đối thủ cạnh tranh loại bỏ trung gian, vừa là đối tác liên kết số&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="360" x="960" y="3730" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E4_SURPLUS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1B5E20;strokeColor=#2E7D32;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="💰 [E4] BÊN THỪA VỐN (KHÁCH HÀNG CÁ NHÂN - RETAIL)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Phân khúc Khách hàng Ưu tiên (Priority/VIP) vs Phổ thông (Mass);&lt;br/&gt;cung cấp tiền gửi CASA giá rẻ và tiêu dùng sản phẩm ngân hàng số&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="3690" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E5_DEFICIT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#BF360C;strokeColor=#E65100;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏭 [E5] BÊN THIẾU VỐN (KHÁCH HÀNG DOANH NGHIỆP - CORPORATE)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Phân khúc Doanh nghiệp lớn (Account Plan may đo) vs SME (chuẩn hóa);&lt;br/&gt;hấp thụ tín dụng, tài trợ thương mại và dịch vụ thanh toán thương mại&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="3690" y="3710" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E7_NONDEP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#4A148C;strokeColor=#6A1B9A;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏢 [E7] ĐỊNH CHẾ PHI TIỀN GỬI (NHĐT, CTCK &amp;amp; BẢO HIỂM)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Đối tác phân phối sản phẩm thị trường vốn, Bancassurance;&lt;br/&gt;hoàn thiện mô hình Universal Banking trong chiến lược đa dạng hóa thu nhập&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="3690" y="3900" as="geometry" />
        </mxCell>
        <mxCell id="G1_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#1A237E;strokeColor=#283593;" value="1.0 🧭 TỔNG QUAN HOẠCH ĐỊNH &amp;amp; THỂ CHẾ VĨ MÔ&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Khái niệm, 3 Câu hỏi Xương sống &amp;amp; Mối liên hệ NHTM - NHTW&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="380" x="1400" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.1 🎯 KHÁI NIỆM CHIẾN LƯỢC &amp;amp; 3 CÂU HỎI &quot;XƯƠNG SỐNG&quot;:&lt;br/&gt;• &lt;b&gt;Chiến lược kinh doanh ngân hàng:&lt;/b&gt; Chương trình hành động dài hạn nhằm tối ưu hóa các mục tiêu cốt lõi: tối đa hóa lợi nhuận, kiểm soát rủi ro, tăng trưởng thị phần và nâng cao giá trị ngân hàng&lt;br/&gt;• &lt;b&gt;Hoạch định chiến lược:&lt;/b&gt; Quá trình thiết lập mục tiêu, xây dựng giải pháp và phân bổ nguồn lực; đòi hỏi sự phối hợp đa chiều và cập nhật liên tục&lt;br/&gt;• &lt;b&gt;Ba câu hỏi chiến lược nền tảng:&lt;/b&gt;&lt;br/&gt;  1. &lt;i&gt;Ngân hàng đang ở đâu?&lt;/i&gt; ➔ Đánh giá vị thế hiện tại qua phân tích SWOT&lt;br/&gt;  2. &lt;i&gt;Ngân hàng muốn đến đâu?&lt;/i&gt; ➔ Xác định tầm nhìn, sứ mệnh và mục tiêu&lt;br/&gt;  3. &lt;i&gt;Đạt đến đó bằng cách nào?&lt;/i&gt; ➔ Lập chương trình hành động và điều phối nguồn lực" vertex="1">
          <mxGeometry height="192" width="380" x="1400" y="3589" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.2 🏆 BỐN TÁC DỤNG CỐT LÕI CỦA HOẠCH ĐỊNH CHIẾN LƯỢC:&lt;br/&gt;• &lt;b&gt;Cầu nối hình thành &amp;amp; thực thi:&lt;/b&gt; Chuyển hóa tầm nhìn chiến lược trên giấy thành kết quả kinh doanh mong muốn; tối ưu hóa phân bổ nguồn lực thực tế&lt;br/&gt;• &lt;b&gt;Nhận dạng cơ hội &amp;amp; Thích nghi môi trường:&lt;/b&gt; Chủ động đón đầu biến động lãi suất, tỷ giá, công nghệ số và sự thay đổi hành vi tiêu dùng tài chính&lt;br/&gt;• &lt;b&gt;Định hướng hoạt động thống nhất:&lt;/b&gt; Tạo sự tập trung toàn hệ thống từ Hội đồng quản trị, Ban điều hành đến toàn bộ mạng lưới chi nhánh/phòng giao dịch&lt;br/&gt;• &lt;b&gt;Công cụ kiểm tra &amp;amp; Đánh giá quản trị:&lt;/b&gt; Cung cấp hệ thống mục tiêu chuẩn mực làm thước đo đánh giá hiệu năng điều hành của từng cấp quản trị" vertex="1">
          <mxGeometry height="205" width="380" x="1406" y="3805" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.3 ⚖️ PHÂN LOẠI HOẠCH ĐỊNH: CHIẾN LƯỢC VS. TÁC NGHIỆP:&lt;br/&gt;• &lt;b&gt;Hoạch định Chiến lược (Strategic Planning):&lt;/b&gt; Tầm nhìn dài hạn (3–5 năm hoặc hơn); phạm vi toàn bộ hệ thống ngân hàng; do HĐQT và Ban TGĐ đảm trách; tập trung vào sứ mệnh, mục tiêu dài hạn, thị trường mục tiêu và mô hình kinh doanh&lt;br/&gt;• &lt;b&gt;Hoạch định Tác nghiệp (Operational Planning):&lt;/b&gt; Tầm nhìn ngắn hạn (năm, quý, tháng); phạm vi từng phòng ban/chi nhánh; do cấp cơ sở thực thi; cụ thể hóa thành kế hoạch huy động vốn, cấp tín dụng, ngân sách chi phí và chỉ tiêu KPI cụ thể&lt;br/&gt;• &lt;b&gt;Mối quan hệ hữu cơ:&lt;/b&gt; Hoạch định chiến lược là &quot;kim chỉ nam&quot; dẫn dắt; hoạch định tác nghiệp là &quot;phương tiện&quot; thực thi; tác nghiệp sai lệch sẽ phá vỡ chiến lược" vertex="1">
          <mxGeometry height="186" width="380" x="1403" y="4037" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.4 🏛️ MỐI LIÊN HỆ GIỮA CHIẾN LƯỢC NHTM [E3] VÀ CHIẾN LƯỢC NHTW [E1]:&lt;br/&gt;• &lt;b&gt;Đặc điểm Chiến lược NHTW [E1]:&lt;/b&gt; Mang tính vĩ mo, định hướng toàn bộ nền kinh tế; mục tiêu kiểm soát lạm phát, ổn định giá trị đồng tiền và an toàn hệ thống (phi lợi nhuận)&lt;br/&gt;• &lt;b&gt;Chiến lược NHTM [E3] - Bộ phận thực thi vĩ mô:&lt;/b&gt; NHTM là một mắt xích trong hệ thống; chiến lược kinh doanh của NHTM không được đi ngược lại chính sách tiền tệ và định hướng tín dụng của NHTW&lt;br/&gt;• &lt;b&gt;Minh họa điều hành tín dụng:&lt;/b&gt; Khi NHNN thắt chặt tăng trưởng tín dụng (áp trần Room tín dụng) hoặc định hướng vốn vào sản xuất kinh doanh/nông nghiệp, NHTM bắt buộc phải tái cấu trúc danh mục cho vay để thích ứng" vertex="1">
          <mxGeometry height="183" width="380" x="1403" y="4246" as="geometry" />
        </mxCell>
        <mxCell id="G2_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#880E4F;strokeColor=#AD1457;" value="2.0 🧱 ĐIỀU KIỆN CẦN &amp;amp; PHÂN CẤP HOẠCH ĐỊNH&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Yêu cầu cốt lõi, 6 Cơ sở Nền tảng &amp;amp; 3 Cấp Quản trị&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="390" x="1840" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;" value="2.1 🎯 HAI YÊU CẦU CỐT LÕI ĐỐI VỚI CHIẾN LƯỢC KINH DOANH:&lt;br/&gt;• &lt;b&gt;Sự tham gia đa chiều và liên cấp:&lt;/b&gt; Chiến lược không thể là &quot;sản phẩm tháp ngà&quot; độc đoán từ cấp cao mà đòi hỏi sự thấu hiểu, đồng thuận và đóng góp từ cấp cơ sở; đảm bảo tính khả thi thực tế&lt;br/&gt;• &lt;b&gt;Tính linh hoạt và thích ứng liên tục:&lt;/b&gt; Cân bằng giữa kiên định mục tiêu dài hạn và linh hoạt điều chỉnh giải pháp ngắn hạn trước các cú sốc vĩ mô (lãi suất, lạm phát, dịch bệnh, xung đột địa chính trị)&lt;br/&gt;• &lt;b&gt;Công thức thành công:&lt;/b&gt; &lt;i&gt;Chiến lược hiệu quả = Sự thấu hiểu &amp;amp; Đồng thuận mọi cấp + Tính linh hoạt điều chỉnh trước biến động thị trường&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="1840" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;" value="2.2 🏛️ SÁU CƠ SỞ NỀN TẢNG ĐỂ XÂY DỰNG CHIẾN LƯỢC:&lt;br/&gt;• &lt;b&gt;1. Đội ngũ nhân viên (Yếu tố con người - Quan trọng nhất):&lt;/b&gt; Trình độ chuyên môn, đạo đức nghề nghiệp, văn hóa dịch vụ; nhân sự quyết định thành bại&lt;br/&gt;• &lt;b&gt;2. Nguồn vốn ngân hàng:&lt;/b&gt; Quy mô vốn điều lệ, vốn tự có (CAR) và năng lực huy động; vốn là &quot;bệ phóng&quot; giới hạn quy mô mở rộng tài sản sinh lời&lt;br/&gt;• &lt;b&gt;3. Cơ sở vật chất &amp;amp; Công nghệ:&lt;/b&gt; Mạng lưới chi nhánh, Core Banking, hạ tầng số, bảo mật dữ liệu; chìa khóa giảm chi phí vận hành (CIR)&lt;br/&gt;• &lt;b&gt;4. Tài sản vô hình (Uy tín &amp;amp; Thương hiệu):&lt;/b&gt; Niềm tin của khách hàng là tài sản quý giá nhất, đặc biệt trong việc duy trì nguồn tiền gửi CASA giá rẻ&lt;br/&gt;• &lt;b&gt;5. Vị thế hiện tại &amp;amp; Mục tiêu tương lai:&lt;/b&gt; Đánh giá đúng năng lực thực chất&lt;br/&gt;• &lt;b&gt;6. Môi trường kinh doanh:&lt;/b&gt; Phân tích nội bộ (SWOT) &amp;amp; môi trường vĩ mô" vertex="1">
          <mxGeometry height="186" width="390" x="1843" y="3733" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;" value="2.3 👥 PHÂN CẤP 3 TẦNG HOẠCH ĐỊNH TRONG NGÂN HÀNG THƯƠNG MẠI:&lt;br/&gt;• &lt;b&gt;Quản trị viên Cấp cao (HĐQT):&lt;/b&gt; Quyền lực quản trị cao nhất; kiến tạo tầm nhìn, đường lối dài hạn (3–5 năm); phân bổ nguồn lực lớn; cấp ngân sách; bổ nhiệm Tổng giám đốc; xác định mô hình (Bán lẻ, Bán buôn hay Đa năng)&lt;br/&gt;• &lt;b&gt;Quản trị viên Cấp trung (Ban điều hành - Ban TGĐ):&lt;/b&gt; Cầu nối chiến lược; chuyển hóa tầm nhìn HĐQT thành chương trình hành động cụ thể; phân bổ chỉ tiêu cho các khối/chi nhánh; giám sát và điều chỉnh tác nghiệp&lt;br/&gt;• &lt;b&gt;Quản trị viên Cấp cơ sở (Giám đốc Chi nhánh/PGD):&lt;/b&gt; Lực lượng trực tiếp thực thi; trực tiếp tiếp xúc khách hàng [E4], [E5]; triển khai bán hàng, quản trị rủi ro tại chỗ; thu thập dữ liệu thị trường phản hồi lên cấp trên&lt;br/&gt;• &lt;b&gt;Ẩn dụ quản trị:&lt;/b&gt; &lt;i&gt;HĐQT vẽ bản đồ &amp;amp; cấp kinh phí — Ban điều hành vạch lộ trình &amp;amp; điều phối — Cấp cơ sở trực tiếp lái xe về đích&lt;/i&gt;" vertex="1">
          <mxGeometry height="199" width="390" x="1843" y="3945" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;" value="2.4 🔄 BA HÌNH THỨC QUAN HỆ VẬN HÀNH GIỮA CÁC CẤP HOẠCH ĐỊNH:&lt;br/&gt;• &lt;b&gt;Quan hệ chuyển giao nhiệm vụ &amp;amp; quyền hạn (Top-Down):&lt;/b&gt; HĐQT giao mục tiêu và ngân sách cho Ban điều hành; Ban điều hành phân bổ chỉ tiêu KPI và quyền hạn tác nghiệp xuống các chi nhánh/phòng ban&lt;br/&gt;• &lt;b&gt;Quan hệ phê duyệt và kiểm soát (Quản trị &amp;amp; Giám sát):&lt;/b&gt; Cấp trên thẩm định, phê duyệt kế hoạch triển khai của cấp dưới; kiểm soát việc tuân thủ hạn mức rủi ro, chính sách tín dụng và tiến độ thực hiện&lt;br/&gt;• &lt;b&gt;Quan hệ báo cáo &amp;amp; Cho ý kiến điều chỉnh (Bottom-Up):&lt;/b&gt; Cấp cơ sở gửi báo cáo định kỳ về kết quả thực tế, những vướng mắc phát sinh từ thị trường để cấp trên kịp thời điều chỉnh kế hoạch kinh doanh&lt;br/&gt;• &lt;b&gt;Chu trình khép kín:&lt;/b&gt; &lt;i&gt;Giao nhiệm vụ ➔ Phê duyệt &amp;amp; Kiểm soát ➔ Báo cáo &amp;amp; Phản hồi&lt;/i&gt;" vertex="1">
          <mxGeometry height="195" width="390" x="1843" y="4169" as="geometry" />
        </mxCell>
        <mxCell id="G3_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#004D40;strokeColor=#00695C;" value="3.0 🎯 MỤC TIÊU &amp;amp; PHÂN KHÚC THỊ TRƯỜNG&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Quy trình Bước 1–5: Sứ mệnh, Thị trường mục tiêu, Phân khúc KH &amp;amp; Cấu trúc ngành&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="2290" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="3.1 🧭 THIẾT LẬP MỤC TIÊU, TUYÊN BỐ SỨ MỆNH &amp;amp; CHÍNH SÁCH:&lt;br/&gt;• &lt;b&gt;Nguyên tắc thiết lập mục tiêu (Objectives):&lt;/b&gt; Rõ ràng, đo lường được, có thời hạn; bao gồm mục tiêu tài chính (ROE, ROA, NIM, CIR, NPL) và phi tài chính (thị phần, sự hài lòng của khách hàng, chuyển đổi số)&lt;br/&gt;• &lt;b&gt;Tuyên bố Sứ mệnh (Mission Statement):&lt;/b&gt; Xác định &quot;sân chơi&quot; của ngân hàng; tuyên bố lý do tồn tại, giá trị cốt lõi mang lại cho khách hàng, cổ đông và cộng đồng xã hội&lt;br/&gt;• &lt;b&gt;Hoạch định Chính sách (Policies):&lt;/b&gt; Là &quot;quy tắc của trò chơi&quot;; các chuẩn mực định hướng hành vi (chính sách tín dụng, khẩu vị rủi ro, chính sách lãi suất)&lt;br/&gt;• &lt;b&gt;Phân tích tình hình (Situation Analysis):&lt;/b&gt; Nhận diện rào cản nội tại cản trở việc đạt mục tiêu" vertex="1">
          <mxGeometry height="166" width="400" x="2290" y="3579" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="3.2 🌐 XÁC ĐỊNH THỊ TRƯỜNG MỤC TIÊU (SERVED MARKET) &amp;amp; MA TRẬN NHU CẦU:&lt;br/&gt;• &lt;b&gt;Thách thức cốt lõi:&lt;/b&gt; Không ngân hàng nào đủ nguồn lực phục vụ toàn bộ thị trường cào bằng; bắt buộc phải xác định chính xác &quot;sân chơi thực tế&quot;&lt;br/&gt;• &lt;b&gt;Ba yếu tố giao thoa cấu thành Thị trường mục tiêu:&lt;/b&gt;&lt;br/&gt;  1. &lt;i&gt;Nhóm khách hàng (Customer Groups):&lt;/i&gt; Khách hàng là ai? (Doanh nghiệp lớn, SME, cá nhân, giới trẻ)&lt;br/&gt;  2. &lt;i&gt;Nhu cầu khách hàng (Customer Needs):&lt;/i&gt; Cần giải pháp gì? (Tiết kiệm, vay mua nhà, thanh toán)&lt;br/&gt;  3. &lt;i&gt;Công nghệ / Sản phẩm (Technologies/Products):&lt;/i&gt; Bằng phương tiện nào? (Ứng dụng số, thẻ, quầy)&lt;br/&gt;• &lt;b&gt;Ma trận Nhu cầu Khách hàng / Sản phẩm:&lt;/b&gt; Công cụ định lượng đối chiếu dòng sản phẩm với từng nhu cầu để tìm khoảng trống thị trường tiềm năng" vertex="1">
          <mxGeometry height="186" width="400" x="2292" y="3771" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="3.3 🏭 PHÂN KHÚC THỊ TRƯỜNG KHÁCH HÀNG DOANH NGHIỆP [E5]:&lt;br/&gt;• &lt;b&gt;Tiếp cận theo Quy mô Doanh nghiệp:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Doanh nghiệp lớn (Large Corporates / Big Accounts):&lt;/i&gt; Số lượng ít nhưng chiếm tỷ trọng dư nợ/doanh thu khổng lồ; đòi hỏi chiến lược riêng biệt (Account Plan may đo), giám đốc quan hệ khách hàng (RM) chuyên trách, giải pháp tài chính tổng thể (Syndicated Loan, bảo lãnh, FX)&lt;br/&gt;  + &lt;i&gt;Doanh nghiệp vừa và nhỏ (SME):&lt;/i&gt; Số lượng áp đảo; phân khúc theo ngành nghề (sản xuất, thương mại, logistics), vùng địa lý; sản phẩm đóng gói chuẩn hóa, tinh gọn quy trình thẩm định&lt;br/&gt;• &lt;b&gt;Biến số phân khúc:&lt;/b&gt; Quy mô doanh thu/tài sản, ngành nghề kinh doanh, vị trí địa lý, cơ cấu sở hữu (FDI, Nhà nước, Tư nhân), xếp hạng tín nhiệm nội bộ" vertex="1">
          <mxGeometry height="160" width="400" x="2292" y="3983" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="3.4 👤 PHÂN KHÚC KHÁCH HÀNG CÁ NHÂN [E4] &amp;amp; ĐẶC ĐIỂM NGÀNH:&lt;br/&gt;• &lt;b&gt;Mô hình Phân khúc Bán lẻ Nhị phân:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Khách hàng Ưu tiên (Priority / VIP Customer):&lt;/i&gt; Thu nhập cao, tài sản tích lũy lớn, số dư tiền gửi cao; ưu tiên bảo toàn vốn, dịch vụ chuyên biệt (Private Lounge, RM riêng), sản phẩm quản lý tài sản, thẻ kim loại cao cấp&lt;br/&gt;  + &lt;i&gt;Khách hàng Phổ thông (Standard / Mass):&lt;/i&gt; Thu nhập trung bình; ưu tiên tiện lợi, phí thấp, giao dịch online 24/7; sản phẩm chuẩn hóa (eKYC, vay tiêu dùng, thẻ tín dụng)&lt;br/&gt;• &lt;b&gt;Ứng dụng Big Data &amp;amp; AI [E8]:&lt;/b&gt; Chấm điểm tín dụng tự động, cá nhân hóa trải nghiệm theo thời gian thực (Hyper-personalization)&lt;br/&gt;• &lt;b&gt;Đặc điểm Cấu trúc Ngành:&lt;/b&gt; Đánh giá Đặc điểm Cầu (quy mô, mùa vụ, độ co giãn lãi suất) vs Đặc điểm Cung/Chi phí (rào cản gia nhập, Core Banking)" vertex="1">
          <mxGeometry height="174" width="400" x="2290" y="4169" as="geometry" />
        </mxCell>
        <mxCell id="G4_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#006064;strokeColor=#00838F;" value="4.0 🔍 NỘI TẠI, CẠNH TRANH &amp;amp; MÔI TRƯỜNG&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Quy trình Bước 6–9: Phân tích SWOT, Vị thế Cạnh tranh, Tính hấp dẫn &amp;amp; PESTLE&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="390" x="2750" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F7FA;strokeColor=#00ACC1;fontColor=#006064;" value="4.1 🔎 ĐÁNH GIÁ VỊ TRÍ HIỆN TẠI QUA SWOT &amp;amp; 4 CÂU HỎI RÀ SOÁT:&lt;br/&gt;• &lt;b&gt;Phân tích SWOT toàn diện:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Điểm mạnh (S) &amp;amp; Điểm yếu (W):&lt;/i&gt; Năng lực nội bộ (vốn tự có CAR, nguồn CASA giá rẻ, mạng lưới, hạ tầng Core Banking, chất lượng nhân sự, nợ xấu NPL)&lt;br/&gt;  + &lt;i&gt;Cơ hội (O) &amp;amp; Thách thức (T):&lt;/i&gt; Môi trường bên ngoài (tăng trưởng GDP, Luật Các TCTD 2024, chuyển dịch số, cạnh tranh gay gắt từ Fintech)&lt;br/&gt;• &lt;b&gt;Bốn Câu hỏi Rà soát Kế hoạch Chiến lược Hiện tại:&lt;/b&gt;&lt;br/&gt;  1. Kế hoạch hiện tại có giải quyết thỏa đáng tất cả vấn đề chiến lược đã xác định?&lt;br/&gt;  2. Kết quả phân tích có gợi ý bất kỳ thay đổi nào trong mục tiêu ngắn/dài hạn?&lt;br/&gt;  3. Cần dùng kênh truyền thông nào để nhân viên toàn hệ thống hiểu rõ chiến lược?&lt;br/&gt;  4. Nguồn nhân lực hiện tại có đủ năng lực và cam kết để thực thi thành công?" vertex="1">
          <mxGeometry height="226" width="390" x="2750" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F7FA;strokeColor=#00ACC1;fontColor=#006064;" value="4.2 🏆 BA TRỤ CỘT ĐO LƯỜNG SỨC MẠNH VỊ THẾ CẠNH TRANH (TRỤC X):&lt;br/&gt;• &lt;b&gt;Trụ cột 1 - Các Thước đo Vị thế Cạnh tranh:&lt;/b&gt; Thị phần huy động và cho vay; Tốc độ tăng trưởng thị phần so với toàn ngành; Năng lực sinh lời (ROA, ROE, NIM); Hiệu quả chi phí (CIR); Mức độ nhận diện thương hiệu và lòng trung thành của khách hàng&lt;br/&gt;• &lt;b&gt;Trụ cột 2 - Đối chuẩn Top 3 Đối thủ Cạnh tranh Lớn nhất:&lt;/b&gt; So sánh trực tiếp từng chỉ tiêu cụ thể với 3 ngân hàng đối thủ mạnh nhất trong cùng phân khúc để nhận diện lợi thế vượt trội hoặc lỗ hổng tụt hậu&lt;br/&gt;• &lt;b&gt;Trụ cột 3 - Năng lực Định vị Chiến lược:&lt;/b&gt; Khả năng khác biệt hóa dịch vụ, độc quyền mạng lưới phân phối, hoặc ưu thế chi phí vốn rẻ (CASA) tạo thành hào lũy phòng thủ cạnh tranh (Competitive Moat)" vertex="1">
          <mxGeometry height="183" width="390" x="2754" y="3825" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F7FA;strokeColor=#00ACC1;fontColor=#006064;" value="4.4 🌐 PHÂN TÍCH 5 NHÓM YẾU TỐ MÔI TRƯỜNG VĨ MÔ &amp;amp; ĐỘ NHẠY:&lt;br/&gt;• &lt;b&gt;Năm Nhóm Yếu tố Vĩ mô Cốt lõi (PESTLE):&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Kinh tế (Economic):&lt;/i&gt; Tăng trưởng GDP, lạm phát, lãi suất điều hành NHNN, tỷ giá&lt;br/&gt;  + &lt;i&gt;Nhân khẩu học (Demographic):&lt;/i&gt; Tháp dân số trẻ, tốc độ đô thị hóa, tầng lớp trung lưu&lt;br/&gt;  + &lt;i&gt;Văn hóa - Xã hội (Socio-cultural):&lt;/i&gt; Thói quen thanh toán không tiền mặt, niềm tin hệ thống&lt;br/&gt;  + &lt;i&gt;Công nghệ (Technological):&lt;/i&gt; AI, Open Banking, sinh trắc học, cạnh tranh Fintech [E8]&lt;br/&gt;  + &lt;i&gt;Chính trị - Pháp lý (Political/Legal):&lt;/i&gt; Luật Các TCTD 2024, Thông tư 14/2025/TT-NHNN&lt;br/&gt;• &lt;b&gt;Nguyên tắc Quản trị Môi trường:&lt;/b&gt; Đưa ra Giả định rõ ràng (Clear Assumptions) và Phân tích Độ nhạy (Sensitivity Analysis) để xây dựng kịch bản ứng phó biến động" vertex="1">
          <mxGeometry height="226" width="390" x="2754" y="4240" as="geometry" />
        </mxCell>
        <mxCell id="G5_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#BF360C;strokeColor=#D84315;" value="5.0 📊 MA TRẬN CHIẾN LƯỢC &amp;amp; KIỂM TRA&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Quy trình Bước 10–11 &amp;amp; Kiểm tra Chiến lược: 9 Ô Định hướng, Kế hoạch 4Ps &amp;amp; Audit&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="410" x="3200" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FBE9E7;strokeColor=#FF7043;fontColor=#BF360C;" value="5.1 🗺️ MA TRẬN DANH MỤC THỊ TRƯỜNG CHIẾN LƯỢC (MA TRẬN 3x3):&lt;br/&gt;• &lt;b&gt;Khung lý thuyết:&lt;/b&gt; Mô hình GE/McKinsey được điều chỉnh cho quản trị NHTM; kết hợp đồng thời hai trục tọa độ chiến lược:&lt;br/&gt;  + &lt;i&gt;Trục hoành (X):&lt;/i&gt; Vị thế Cạnh tranh của Ngân hàng (Mạnh - Trung bình - Yếu)&lt;br/&gt;  + &lt;i&gt;Trục tung (Y):&lt;/i&gt; Tính Hấp dẫn của Thị trường Mục tiêu (Cao - Trung bình - Thấp)&lt;br/&gt;• &lt;b&gt;Phân bổ ma trận 9 ô:&lt;/b&gt; Mỗi phân khúc kinh doanh (vay mua nhà, SME xuất khẩu, thẻ tín dụng, ngân hàng số) được định vị vào một ô cụ thể dựa trên tọa độ (X, Y)&lt;br/&gt;• &lt;b&gt;Nguyên lý Cân đối Dòng tiền:&lt;/b&gt; Sử dụng lợi nhuận tích lũy (thu hoạch) từ các ô vị thế mạnh/thị trường bão hòa để tái đầu tư vào các ô thị trường hấp dẫn cao nhằm chiếm lĩnh vị thế dẫn đầu tương lai" vertex="1">
          <mxGeometry height="180" width="410" x="3200" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FBE9E7;strokeColor=#FF7043;fontColor=#BF360C;" value="5.2 🧭 CHI TIẾT ĐỊNH HƯỚNG CHIẾN LƯỢC TRONG 9 Ô MA TRẬN:&lt;br/&gt;• &lt;b&gt;Nhóm Thị trường Hấp dẫn CAO:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Ô 1 (Mạnh + Cao): Tăng trưởng / Cân bằng (Grow/Balanced)&lt;/i&gt; ➔ Ưu tiên nguồn lực lớn nhất, duy trì vị thế dẫn đầu&lt;br/&gt;  + &lt;i&gt;Ô 2 (TB + Cao): Tăng trưởng / Thâm nhập (Grow/Penetrate)&lt;/i&gt; ➔ Tăng đầu tư, đẩy mạnh thâm nhập nâng lên Mạnh&lt;br/&gt;  + &lt;i&gt;Ô 3 (Yếu + Cao): Thu hoạch / Tái cấu trúc (Harvest/Rebuild)&lt;/i&gt; ➔ Tái cơ cấu toàn diện hoặc rút vốn cắt lỗ&lt;br/&gt;• &lt;b&gt;Nhóm Thị trường Hấp dẫn TRUNG BÌNH:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Ô 4 (Mạnh + TB): Phòng thủ / Đầu tư&lt;/i&gt; ➔ Duy trì vị thế hiện có, dựng rào cản ngăn đối thủ&lt;br/&gt;  + &lt;i&gt;Ô 5 (TB + TB): Đầu tư có chọn lọc&lt;/i&gt; ➔ Tập trung vào tiểu phân khúc biên lợi nhuận cao&lt;br/&gt;  + &lt;i&gt;Ô 6 (Yếu + TB): Rút lui êm đẹp / Tìm ngách&lt;/i&gt; ➔ Thu hẹp có trật tự hoặc chuyển sang thị trường ngách&lt;br/&gt;• &lt;b&gt;Nhóm Thị trường Hấp dẫn THẤP:&lt;/b&gt;&lt;br/&gt;  + &lt;i&gt;Ô 7 (Mạnh + Thấp): Thu hoạch&lt;/i&gt; | &lt;i&gt;Ô 8 (TB + Thấp): Rút lui êm đẹp&lt;/i&gt; | &lt;i&gt;Ô 9 (Yếu + Thấp): Rút lui nhanh / Tấn công&lt;/i&gt;" vertex="1">
          <mxGeometry height="274" width="410" x="3200" y="3770.5" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FBE9E7;strokeColor=#FF7043;fontColor=#BF360C;" value="5.3 📋 PHÁT TRIỂN KẾ HOẠCH PHÂN KHÚC &amp;amp; VÒNG LẶP PHẢN HỒI:&lt;br/&gt;• &lt;b&gt;Nội dung điều chỉnh trong Kế hoạch Phân khúc:&lt;/b&gt; Cụ thể hóa Marketing-mix (4Ps) sau khi định vị trên ma trận 9 ô:&lt;br/&gt;  + &lt;i&gt;Product:&lt;/i&gt; Thiết kế, may đo hoặc đóng gói lại sản phẩm phù hợp phân khúc&lt;br/&gt;  + &lt;i&gt;Price:&lt;/i&gt; Điều chỉnh chính sách lãi suất, phí dịch vụ cạnh tranh&lt;br/&gt;  + &lt;i&gt;Place:&lt;/i&gt; Tối ưu kênh phân phối (phòng giao dịch vật lý vs App ngân hàng số)&lt;br/&gt;  + &lt;i&gt;Promotion:&lt;/i&gt; Chiến dịch tiếp thị, quảng bá và bán chéo (Cross-selling)&lt;br/&gt;• &lt;b&gt;Vòng lặp Quy trình Hoạch định (Feedback Loop):&lt;/b&gt; Quy trình 11 bước (4.3.1 – 4.3.11) là chu trình lặp tuần hoàn: &lt;i&gt;Mục tiêu ➔ Phân khúc ➔ SWOT &amp;amp; Vị thế ➔ Ma trận 9 ô ➔ Kế hoạch hành động ➔ Phản hồi điều chỉnh&lt;/i&gt;" vertex="1">
          <mxGeometry height="174" width="410" x="3200" y="4072" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#FBE9E7;strokeColor=#FF7043;fontColor=#BF360C;" value="5.4 🛡️ KIỂM TRA CHIẾN LƯỢC (STRATEGIC CONTROL &amp;amp; AUDIT):&lt;br/&gt;• &lt;b&gt;Bản chất &amp;amp; 3 Mục đích Cốt lõi:&lt;/b&gt; Kiểm tra là thành tố khép kín chu trình quản trị; nhằm: (1) Đánh giá sự phù hợp với từng phân khúc; (2) Đo lường mức độ hoàn thành chỉ tiêu KPI; (3) Nhận diện sớm sai lệch và rủi ro trồi hiện&lt;br/&gt;• &lt;b&gt;Ba Chức năng Điều chỉnh:&lt;/b&gt; Phát hiện mâu thuẫn/xung đột nội tại; Cơ sở đánh giá lại và cập nhật liên tục; Thiết lập dòng thông tin phản hồi (Feedback)&lt;br/&gt;• &lt;b&gt;Ba Nguyên tắc &amp;amp; Tư tưởng Kiểm tra Chiến lược:&lt;/b&gt;&lt;br/&gt;  1. &lt;i&gt;Tư tưởng tích cực (Positive Philosophy):&lt;/i&gt; Kiểm tra là cơ hội học hỏi, cải tiến năng lực&lt;br/&gt;  2. &lt;i&gt;Nguyên tắc &quot;Không trừng phạt - Không áp đặt&quot;:&lt;/i&gt; Khuyến khích sự trung thực, đối thoại cởi mở thay vì che giấu sai sót do sợ phạt&lt;br/&gt;  3. &lt;i&gt;Nguyên tắc linh hoạt &amp;amp; Cải tiến liên tục:&lt;/i&gt; Chiến lược luôn sẵn sàng điều chỉnh thích nghi" vertex="1">
          <mxGeometry height="208" width="410" x="3200" y="4274" as="geometry" />
        </mxCell>

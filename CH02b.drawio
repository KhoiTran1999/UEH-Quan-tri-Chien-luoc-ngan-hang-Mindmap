        <mxCell id="EDGE_ROOT_G5" parent="1" source="E7_ROOT" target="G5_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;curved=0;strokeColor=#BF360C;strokeWidth=2;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" value="5.0 Universal Banking VN" edge="1">

          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EDGE_ROOT_G5" edge="1" parent="1" source="E3_ROOT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;curved=0;strokeColor=#BF360C;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" target="G5_HEADER" value="5.0 Rủi ro thị trường (S) &amp; GAP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EDGE_G1_C1" edge="1" parent="1" source="G1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;curved=0;strokeColor=#1A237E;" target="G1_CARD_1" value="">

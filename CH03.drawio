        </mxCell>
        <mxCell id="EDGE_G1_C4" edge="1" parent="1" points="[(1400, 3560), (1370, 3560), (1370, 4087), (1400, 4087)]" source="G1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;curved=0;strokeColor=#1A237E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="G1_CARD_4" value="">
          <mxGeometry relative="1" as="geometry">

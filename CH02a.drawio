<mxfile host="Electron">
  <diagram name="Quản trị và Chiến lược Ngân hàng - Chương 2a" id="Chapter2a-CommercialBank-Mindmap">
    <mxGraphModel dx="8" dy="-2292" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TITLE_BANNER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;shadow=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="95" width="2350" x="1324" y="3103" as="geometry" />
        </mxCell>
        <mxCell id="TITLE_TEXT" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#ffffff;fontSize=24;fontStyle=1;" value="CHƯƠNG 2a: CÁC HOẠT ĐỘNG KINH DOANH CHỦ YẾU CỦA NGÂN HÀNG THƯƠNG MẠI&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.85; color: #94a3b8;&quot;&gt;Entity-based Hierarchical Mindmap | Đào sâu [E3] Ngân hàng thương mại | Khung Luật Các TCTD 2024 &amp;amp; Chuẩn Basel&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="2310" x="1344" y="3113" as="geometry" />
        </mxCell>
        <mxCell id="E3_ROOT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0D47A1;strokeColor=#1565C0;fontColor=#ffffff;fontStyle=1;fontSize=14;shadow=1;fontFamily=Helvetica;" value="🏛️ [E3] TRỤC CỐT LÕI: NGÂN HÀNG THƯƠNG MẠI (COMMERCIAL BANK - NHTM)&lt;br/&gt;&lt;span style=&quot;opacity: 0.9; font-size: 11px; font-weight: normal;&quot;&gt;Trái tim Hệ thống Tài chính | Đặc quyền Tiền gửi Cá nhân &amp;amp; Độc quyền Dịch vụ Thanh toán qua Tài khoản&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="620" x="2480" y="3250" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E1_NHNN" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#37474F;strokeColor=#212121;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏛️ [E1] NGÂN HÀNG TRUNG ƯƠNG (NHNN)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Dự trữ bắt buộc (d=10%), Giám sát Luật TCTD 2024, Tái cấp vốn &amp;amp; Room tín dụng&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="380" x="1750" y="3250" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E4_SURPLUS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1B5E20;strokeColor=#2E7D32;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="💰 [E4] BÊN THỪA VỐN (SURPLUS UNITS)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Người gửi tiền cá nhân &amp;amp; tổ chức&lt;br/&gt;Cung ứng vốn CASA &amp;amp; Tiết kiệm chi phí rẻ nhất&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="360" x="960" y="3610" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E7_NONDEP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#4A148C;strokeColor=#6A1B9A;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏢 [E7] ĐỊNH CHẾ PHI TIỀN GỬI (CTTC &amp;amp; CTCK)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;TCTD phi ngân hàng: Cấm nhận tiền gửi cá nhân &amp;amp; Cấm thanh toán qua TK&lt;br/&gt;Hệ sinh thái CT con: CTCK, Bảo hiểm, Cho thuê tài chính&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="960" y="3800" as="geometry" />
        </mxCell>
        <mxCell id="EXT_E5_DEFICIT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#BF360C;strokeColor=#E65100;fontColor=#ffffff;fontStyle=1;fontSize=11;shadow=1;fontFamily=Helvetica;align=center;" value="🏭 [E5] BÊN THIẾU VỐN (DEFICIT UNITS)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 10px; font-weight: normal;&quot;&gt;Doanh nghiệp SXKD, Dự án &amp;amp; Hộ tiêu dùng&lt;br/&gt;Hấp thụ tín dụng, phát sinh nghĩa vụ nợ &amp;amp; rủi ro nợ xấu&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="3848" y="3747.5" as="geometry" />
        </mxCell>
        <mxCell id="G1_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#1A237E;strokeColor=#283593;" value="1.0 ⚖️ VỊ THẾ PHÁP LÝ &amp;amp; BẢN CHẤT TCTD&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Ranh giới độc quyền &amp;amp; Khung Luật Các TCTD 2024&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="380" x="1400" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.1 🎯 QUAN HỆ TCTD - NHTM &amp;amp; MỤC TIÊU LỢI NHUẬN:&lt;br/&gt;• &lt;b&gt;Quan hệ Cha - Con:&lt;/b&gt; TCTD là khái niệm rộng (doanh nghiệp thực hiện 1 hoặc một số HĐNH); NHTM là TCTD đặc thù thực hiện đầy đủ toàn bộ HĐNH&lt;br/&gt;• &lt;b&gt;Mục tiêu lợi nhuận:&lt;/b&gt; Phân biệt NHTM với Ngân hàng Chính sách (VBSP, VDB - hoạt động phi lợi nhuận, thực thi an sinh xã hội)&lt;br/&gt;• &lt;b&gt;Bộ ba HĐNH cốt lõi:&lt;/b&gt; Nhận tiền gửi ➔ Cấp tín dụng ➔ Dịch vụ thanh toán (mang nội dung thường xuyên, liên tục)" vertex="1">
          <mxGeometry height="120" width="380" x="1400" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.2 🛡️ HAI THÀNH TRÌ ĐỘC QUYỀN VỮNG CHẮC CỦA NHTM:&lt;br/&gt;• &lt;b&gt;Độc quyền nhận tiền gửi cá nhân:&lt;/b&gt; Bảo vệ đối tượng yếu thế thiếu thông tin; mang lại nguồn vốn dồi dào, chi phí rẻ nhất (CASA ~0%)&lt;br/&gt;• &lt;b&gt;Độc quyền cung ứng DV thanh toán qua tài khoản:&lt;/b&gt; Đòi hỏi quy mô vốn lớn (vốn pháp định tối thiểu 3.000 tỷ; thực tế 40.000 - 80.000 tỷ)&lt;br/&gt;• &lt;b&gt;Bảo đảm an toàn giao dịch nghìn tỷ:&lt;/b&gt; Chỉ có NHTM mới đủ uy tín xử lý giao dịch quy mô khổng lồ (điển hình thương vụ ThaiBev mua Sabeco 5 tỷ USD qua VCB)" vertex="1">
          <mxGeometry height="125" width="380" x="1400" y="3715" as="geometry" />
        </mxCell>
        <mxCell id="G1_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5C6BC0;fontColor=#1A237E;" value="1.3 📊 SO SÁNH PHÁP NHÂN CÁC TCTD TẠI VIỆT NAM:&lt;br/&gt;• &lt;b&gt;TCTD phi ngân hàng (CTTC, Leasing):&lt;/b&gt; CẤM nhận tiền gửi cá nhân; CẤM thanh toán qua tài khoản; chỉ nhận tiền gửi tổ chức &amp;amp; cho vay tiêu dùng/thuê mua&lt;br/&gt;• &lt;b&gt;Tổ chức Tài chính vi mô (CEP, TYM):&lt;/b&gt; CHỈ cấp tín dụng bằng VND dưới hình thức cho vay hộ nghèo, DN siêu nhỏ; cấm bảo lãnh, leasing&lt;br/&gt;• &lt;b&gt;Quỹ Tín dụng Nhân dân:&lt;/b&gt; Mô hình hợp tác xã tương trợ thành viên địa phương; huy động và cho vay chủ yếu trong nội bộ thành viên" vertex="1">
          <mxGeometry height="130" width="380" x="1400" y="3860" as="geometry" />
        </mxCell>
        <mxCell id="G2_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#004D40;strokeColor=#00695C;" value="2.0 🧬 BA CHỨC NĂNG CỐT LÕI (BỘ GEN SINH TỒN)&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Trung gian Tài chính, Thanh toán &amp;amp; Nhân bản Bút tệ&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="390" x="1840" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="2.1 🔄 TRUNG GIAN TÀI CHÍNH &amp;amp; CHÊNH LỆCH LÃI SUẤT (SPREAD):&lt;br/&gt;• &lt;b&gt;Hóa giải xung đột kỳ hạn Hicks (1939):&lt;/b&gt; Vay ngắn hạn (tiền gửi thanh khoản cao) để Cho vay dài hạn (dự án, nhà ở 25 năm)&lt;br/&gt;• &lt;b&gt;Phân tán rủi ro (Pooling &amp;amp; Spreading):&lt;/b&gt; Quy mô hàng triệu khách hàng giúp triệt tiêu rủi ro thanh khoản cá biệt&lt;br/&gt;• &lt;b&gt;Cỗ máy in tiền NIM (Spread):&lt;/b&gt; Đóng góp 70% - 80% tổng lợi nhuận của NHTM Việt Nam (NII là trụ cột sống còn)&lt;br/&gt;• &lt;b&gt;Ưu thế trước P2P Lending:&lt;/b&gt; NHTM cam kết trả nợ 100% vô điều kiện; P2P rủi ro bùng nợ/sập nền tảng người cho vay tự chịu" vertex="1">
          <mxGeometry height="135" width="390" x="1840" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="2.2 💳 TRUNG GIAN THANH TOÁN - HUYẾT MẠCH KINH TẾ:&lt;br/&gt;• &lt;b&gt;Thủ quỹ của nền kinh tế:&lt;/b&gt; Mở tài khoản, quản lý tiền gửi thanh toán, cung ứng phương tiện séc, thẻ, ủy nhiệm chi (UNC), bù trừ điện tử&lt;br/&gt;• &lt;b&gt;Đảm bảo lưu thông không gián đoạn:&lt;/b&gt; Nếu dịch vụ thanh toán ngưng trệ, toàn bộ giao dịch thương mại trong xã hội lập tức đóng băng&lt;br/&gt;• &lt;b&gt;Bản chất tiền lương:&lt;/b&gt; Nhận lương qua tài khoản ngân hàng thực chất là hành vi gửi tiền không kỳ hạn (CASA giá rẻ) vào NHTM" vertex="1">
          <mxGeometry height="115" width="390" x="1840" y="3730" as="geometry" />
        </mxCell>
        <mxCell id="G2_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#26A69A;fontColor=#004D40;" value="&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;div&gt;2.3 🪄 CHỨC NĂNG TẠO TIỀN BÚT TỆ (CREATION OF MONEY):&lt;/div&gt;&lt;div&gt;• Cơ chế tạo tiền liên ngân hàng: Tiền gửi ban đầu \(U\) ➔ trích Dự trữ bắt buộc (\(d = 10\%\)) ➔ Cho vay tối đa (\(q = 90\%\)) ➔ gửi vào NH kế tiếp&lt;/div&gt;&lt;div&gt;• Công thức cấp số nhân: \(\displaystyle S_n = \frac{U(1 - q^n)}{1 - q}\); với \(n = 10\), từ \(U = 5.000\) tạo ra \(S_{10} = 32.566,1\) triệu VND tiền gửi mới&lt;/div&gt;&lt;div&gt;• Hệ số nhân tiền cực đại: \(\displaystyle k = \frac{1}{d} = 10\); Cung tiền mở rộng gấp 10 lần: \(\displaystyle S_\infty = \frac{U}{d} = 50.000\) triệu VND&lt;/div&gt;&lt;div&gt;• Yếu tố rò rỉ làm giảm tạo tiền: Ngân hàng giữ dự trữ vượt mức (phòng thủ thanh khoản); Người dân rút tiền mặt chi tiêu ngoài hệ thống&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="213" width="390" x="1840" y="3878" as="geometry" />
        </mxCell>
        <mxCell id="G3_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#0277BD;strokeColor=#0288D1;" value="3.0 🏛️ HỆ THỐNG PHÂN LOẠI NGÂN HÀNG THƯƠNG MẠI&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Sở hữu, Chiến lược Khách hàng &amp;amp; Lĩnh vực Hoạt động&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="390" x="2290" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E1F5FE;strokeColor=#29B6F6;fontColor=#01579B;" value="3.1 🏢 PHÂN LOẠI THEO HÌNH THỨC SỞ HỮU (OWNERSHIP):&lt;br/&gt;• &lt;b&gt;NHTM Nhà nước (Big 4):&lt;/b&gt; Nắm 70% - 80% thị phần tín dụng/tiền gửi; Agribank là 100% vốn NN; VCB, CTG, BIDV NN nắm cổ phần chi phối tuyệt đối&lt;br/&gt;• &lt;b&gt;31 NHTM Cổ phần:&lt;/b&gt; Mô hình quản trị ĐHĐCĐ, HĐQT, BKS; chiếm 23% - 24% thị phần (ACB, Techcombank, MB, VPBank...)&lt;br/&gt;• &lt;b&gt;2 NH Liên doanh &amp;amp; 9 NH 100% vốn nước ngoài:&lt;/b&gt; Pháp nhân TNHH Việt Nam độc lập (HSBC, Standard Chartered, Shinhan...)&lt;br/&gt;• &lt;b&gt;52 Chi nhánh NH nước ngoài:&lt;/b&gt; Đơn vị phụ thuộc pháp nhân mẹ; KHÔNG được góp vốn, mua cổ phần tại VN (Citibank, SMBC...)" vertex="1">
          <mxGeometry height="140" width="390" x="2290" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E1F5FE;strokeColor=#29B6F6;fontColor=#01579B;" value="3.2 🎯 PHÂN LOẠI THEO CHIẾN LƯỢC KINH DOANH &amp;amp; NGÂN HÀNG SỐ:&lt;br/&gt;• &lt;b&gt;Bán buôn (Wholesale):&lt;/b&gt; Phục vụ tập đoàn lớn, FDI, đa quốc gia; mạng lưới chi nhánh vật lý tinh gọn (chi nhánh ngân hàng ngoại, khối KHDN lớn VCB/BIDV)&lt;br/&gt;• &lt;b&gt;Bán lẻ (Retail) &amp;amp; Mô hình hỗn hợp:&lt;/b&gt; Phục vụ cá nhân, SME, vay mua nhà, thẻ; hầu hết NHTMCP VN vận hành hỗn hợp để tối ưu doanh số&lt;br/&gt;• &lt;b&gt;Bản chất Ngân hàng số (Cake, VCB Digibank):&lt;/b&gt; Không phải pháp nhân độc lập; là chiến lược kinh doanh/kênh phân phối công nghệ được bảo trợ pháp lý bởi ngân hàng mẹ" vertex="1">
          <mxGeometry height="145" width="390" x="2290" y="3735" as="geometry" />
        </mxCell>
        <mxCell id="G3_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#E1F5FE;strokeColor=#29B6F6;fontColor=#01579B;" value="3.3 🌐 LĨNH VỰC HOẠT ĐỘNG: NHTM TRUYỀN THỐNG VS. NGÂN HÀNG ĐẦU TƯ (IB):&lt;br/&gt;• &lt;b&gt;Chuyên doanh vs. Đa năng (Universal Banking):&lt;/b&gt; Xu hướng lập công ty con (chứng khoán, bảo hiểm, leasing) để bán chéo trọn gói&lt;br/&gt;• &lt;b&gt;NHTM:&lt;/b&gt; Nhận tiền gửi cá nhân rẻ nhất; Doanh thu phụ thuộc Net Interest Income (NII chiếm ~83%); Tài sản hạch toán &lt;b&gt;Banking Book&lt;/b&gt; (tích lũy ổn định)&lt;br/&gt;• &lt;b&gt;Investment Bank (IB):&lt;/b&gt; Không nhận tiền gửi lẻ; Doanh thu từ Phí dịch vụ (~49%) &amp;amp; Tự doanh (~32%); Tài sản nằm ở &lt;b&gt;Trading Book&lt;/b&gt; (Mark-to-market)" vertex="1">
          <mxGeometry height="140" width="390" x="2290" y="3908" as="geometry" />
        </mxCell>
        <mxCell id="G4_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#3E2723;strokeColor=#4E342E;" value="4.0 🏢 CƠ CẤU TỔ CHỨC &amp;amp; QUẢN TRỊ THƯỢNG TẦNG&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Mạng lưới Không gian, Ba sảnh Vận hành &amp;amp; Ủy ban ALCO&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="2740" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EFEBE9;strokeColor=#8D6E63;fontColor=#3E2723;" value="4.1 🗺️ MẠNG LƯỚI KHÔNG GIAN ĐỊA LÝ &amp;amp; PHÂN PHỐI VẬT LÝ:&lt;br/&gt;• &lt;b&gt;Hội sở chính (Head Office):&lt;/b&gt; Trung tâm quyền lực tối cao; đóng vai trò Back &amp;amp; Middle Office quản trị hệ thống, hoạch định chiến lược, CNTT, kiểm toán, Khối số&lt;br/&gt;• &lt;b&gt;Chi nhánh (Branch):&lt;/b&gt; Tiền sảnh (Front Office) trực tiếp kinh doanh; thẩm quyền phê duyệt tín dụng theo hạn mức ủy quyền của Hội sở&lt;br/&gt;• &lt;b&gt;Phòng giao dịch (Transaction Office):&lt;/b&gt; Trực thuộc Chi nhánh, đặt tại khu dân cư/trường học/siêu thị; nhân sự gọn nhẹ (5-10 người) phục vụ giao dịch cơ bản" vertex="1">
          <mxGeometry height="130" width="400" x="2740" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EFEBE9;strokeColor=#8D6E63;fontColor=#3E2723;" value="4.2 ⚙️ MÔ HÌNH VẬN HÀNH 3 SẢNH CHUYÊN SÂU (FRONT - MIDDLE - BACK):&lt;br/&gt;• &lt;b&gt;Tiền sảnh (Front Office):&lt;/b&gt; Trực tiếp tiếp xúc khách hàng, gồm Khối Bán lẻ (Retail), Doanh nghiệp (Corporate), Bán buôn (Wholesale), IB, Quản lý tài sản (Wealth)&lt;br/&gt;• &lt;b&gt;Trung sảnh (Middle Office):&lt;/b&gt; Độc lập với kinh doanh; Đo lường rủi ro danh mục, mô hình hóa điểm tín dụng, giám sát thu hồi nợ, quản lý tài sản bảo đảm (TSĐB)&lt;br/&gt;• &lt;b&gt;Hậu sảnh (Back Office):&lt;/b&gt; Xử lý dữ liệu, đối chiếu thanh toán, giải ngân, kế toán, ngân quỹ, CNTT và Nhân sự (HR)" vertex="1">
          <mxGeometry height="150" width="400" x="2740" y="3715" as="geometry" />
        </mxCell>
        <mxCell id="G4_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#EFEBE9;strokeColor=#8D6E63;fontColor=#3E2723;" value="4.3 👑 QUẢN TRỊ THƯỢNG TẦNG &amp;amp; VAI TRÒ SỐNG CÒN CỦA ỦY BAN ALCO:&lt;br/&gt;• &lt;b&gt;HĐQT &amp;amp; Ủy ban QL Rủi ro:&lt;/b&gt; Phê duyệt chính sách, khẩu vị rủi ro và các hạn mức lớn toàn hệ thống; giám sát độc lập ban điều hành&lt;br/&gt;• &lt;b&gt;Tổng Giám đốc (CEO):&lt;/b&gt; Điều hành kinh doanh hàng ngày, triển khai chiến lược HĐQT phê duyệt&lt;br/&gt;• &lt;b&gt;Ủy ban Quản lý Tài sản Nợ - Có (ALCO):&lt;/b&gt; Ủy ban quyền lực nhất; Giám đốc Tài chính (CFO) làm Chủ tịch; quản trị cân đối Bảng CĐKT, thanh khoản LCR/NSFR, rủi ro lãi suất IRRBB &amp;amp; định giá vốn nội bộ FTP&lt;br/&gt;• &lt;b&gt;Ủy ban Chính sách Tín dụng:&lt;/b&gt; CEO làm Chủ tịch; thẩm định phê duyệt hồ sơ vượt hạn mức chi nhánh" vertex="1">
          <mxGeometry height="165" width="400" x="2740" y="3887" as="geometry" />
        </mxCell>
        <mxCell id="G5_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#ffffff;fontStyle=1;fontSize=12;shadow=1;fontFamily=Helvetica;align=center;fillColor=#4A148C;strokeColor=#6A1B9A;" value="5.0 💼 BỐN HOẠT ĐỘNG KINH DOANH CHỦ YẾU CỦA NHTM&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.9;&quot;&gt;Huy động vốn, Cấp tín dụng, Thanh toán &amp;amp; Kinh doanh khác&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="410" x="3200" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#AB47BC;fontColor=#4A148C;" value="5.1 📥 I. HOẠT ĐỘNG HUY ĐỘNG VỐN (CAPITAL MOBILIZATION):&lt;br/&gt;• &lt;b&gt;Nhận tiền gửi (Nguồn vốn rẻ nhất):&lt;/b&gt; Tiền gửi thanh toán không kỳ hạn (CASA giá rẻ ~0%), Tiết kiệm kỳ hạn đường cong lợi suất dương, Tiền gửi TCTD khác&lt;br/&gt;• &lt;b&gt;Phát hành giấy tờ có giá (GTCG):&lt;/b&gt; Chứng chỉ tiền gửi (CDs), kỳ phiếu, tín phiếu, trái phiếu trung dài hạn&lt;br/&gt;• &lt;b&gt;Vay vốn liên ngân hàng &amp;amp; NHNN:&lt;/b&gt; Vay qua đêm/ngắn hạn bù đắp thanh khoản; vay tái cấp vốn NHNN&lt;br/&gt;• &lt;b&gt;Bản chất tài chính:&lt;/b&gt; Chi phí lãi phát sinh (Nguồn vốn đầu vào); đối mặt rủi ro thanh khoản nếu khách hàng rút tiền đồng loạt" vertex="1">
          <mxGeometry height="130" width="410" x="3200" y="3575" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#AB47BC;fontColor=#4A148C;" value="5.2 💸 II. HOẠT ĐỘNG CẤP TÍN DỤNG (CREDIT EXTENSION):&lt;br/&gt;• &lt;b&gt;Đa dạng hình thức cấp tín dụng:&lt;/b&gt; Cho vay (ngắn/trung/dài hạn - chiếm tỷ trọng lớn nhất); Bảo lãnh ngân hàng; Bao thanh toán (Factoring); Chiết khấu GTCG; Cho thuê tài chính (Leasing - tối ưu thuế/TSĐB)&lt;br/&gt;• &lt;b&gt;Trụ cột doanh thu:&lt;/b&gt; Mang lại Thu nhập lãi thuần (NII), đóng góp 70% tổng lợi nhuận ngân hàng (điển hình Vietinbank lãi 30k tỷ thì 21k tỷ từ tín dụng)&lt;br/&gt;• &lt;b&gt;Rủi ro cốt tử:&lt;/b&gt; Rủi ro tín dụng vỡ nợ (NPL) &amp;amp; Rủi ro chênh lệch kỳ hạn (The Gap) do huy động ngắn cho vay dài" vertex="1">
          <mxGeometry height="135" width="410" x="3200" y="3725" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#AB47BC;fontColor=#4A148C;" value="5.3 💳 III. DỊCH VỤ THANH TOÁN VÀ NGÂN QUỸ (PAYMENT &amp;amp; CASH):&lt;br/&gt;• &lt;b&gt;Phương tiện thanh toán:&lt;/b&gt; Cung ứng séc (cheque), ủy nhiệm chi (UNC), ủy nhiệm thu, thẻ ngân hàng ghi nợ/tín dụng&lt;br/&gt;• &lt;b&gt;Dịch vụ thanh toán trong nước &amp;amp; quốc tế:&lt;/b&gt; Chuyển tiền điện tử, thanh toán hóa đơn, phát hành L/C (Thư tín dụng), nhờ thu quốc tế&lt;br/&gt;• &lt;b&gt;Dịch vụ thu hộ &amp;amp; chi hộ:&lt;/b&gt; Thu hộ học phí, chi trả lương cho doanh nghiệp và trường đại học (như Agribank phục vụ UEH)&lt;br/&gt;• &lt;b&gt;Nguồn thu nhập:&lt;/b&gt; Đem lại Thu nhập phí thuần (Fee income); đối mặt rủi ro vận hành (Operational risk/lỗi hệ thống)" vertex="1">
          <mxGeometry height="130" width="410" x="3200" y="3880" as="geometry" />
        </mxCell>
        <mxCell id="G5_CARD_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#AB47BC;fontColor=#4A148C;" value="5.4 🌐 IV. HOẠT ĐỘNG KINH DOANH KHÁC (OTHER ACTIVITIES):&lt;br/&gt;• &lt;b&gt;Góp vốn, mua cổ phần:&lt;/b&gt; Thành lập/mua lại công ty con bảo hiểm, chứng khoán, quản lý quỹ, leasing để phát triển Universal Banking &amp;amp; Bán chéo (Bancassurance)&lt;br/&gt;• &lt;b&gt;Thị trường tiền tệ &amp;amp; Phái sinh:&lt;/b&gt; Đấu thầu tín phiếu Kho bạc, mua bán TPCP; Kinh doanh ngoại hối (FX Spot/Forward), phái sinh lãi suất (IRS, CCS)&lt;br/&gt;• &lt;b&gt;Ngân hàng Giám sát (Custodian Bank):&lt;/b&gt; Lưu ký và giám sát dòng tiền các quỹ đầu tư 5.000 - 7.000 tỷ VND, thu phí béo bở&lt;br/&gt;• &lt;b&gt;Hạch toán:&lt;/b&gt; Phân định rõ Banking Book (giữ đến hạn) và Trading Book (đánh giá theo giá thị trường Mark-to-Market)" vertex="1">
          <mxGeometry height="145" width="410" x="3200" y="4030" as="geometry" />
        </mxCell>
        <mxCell id="EDGE_ROOT_G2" edge="1" parent="1" source="E3_ROOT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;curved=0;strokeColor=#004D40;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" target="G2_HEADER" value="2.0 Chức năng cốt lõi">
